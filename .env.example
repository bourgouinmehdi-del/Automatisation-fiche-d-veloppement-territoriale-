# --- Répertoire de données (cache HTTP + rapports générés) ---
DATA_DIR=./data

# --- Durée de vie du cache HTTP, en heures (défaut : 720 h = 30 jours) ---
CACHE_TTL_HOURS=720

# --- Délai maximal par requête HTTP, en millisecondes ---
HTTP_TIMEOUT_MS=20000

# --- Mode hors ligne : n'interroge aucune API distante, utilise uniquement
#     le cache et les référentiels embarqués (découpage administratif) ---
OFFLINE=0

# --- Rédaction assistée par modèle de langage (facultatif) ---
# Par défaut, les textes sont produits par des gabarits déterministes.
# LLM_PROVIDER=none | anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Export PDF : chemin vers un exécutable Chromium/Chrome ---
# Laisser vide pour la détection automatique.
CHROMIUM_PATH=

# --- Overpass (OpenStreetMap) : instance à utiliser ---
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Intervalle minimal entre requêtes INSEE (ms) ; limite publique 30 req/min ---
INSEE_MIN_INTERVAL_MS=2100

# --- Sources volumineuses (premier téléchargement de plusieurs centaines de Mo,
#     mis en cache ensuite) : les désactiver au besoin, séparées par des virgules.
#     Valeurs possibles : qpv, iris, municipales, bpe, gtfs, osrm
DISABLE_SOURCES=

# --- Calcul d'itinéraires routiers (OSRM) : serveur de démonstration par défaut ---
# OSRM_URL=https://router.project-osrm.org

# --- Performance et mémoire ---
# Générations simultanées (1 conseillé sur un petit hébergement)
GENERATION_CONCURRENCY=1
# Traitements de fichiers nationaux simultanés (attente automatique si la mémoire dépasse 60 % de la limite)
HEAVY_CONCURRENCY=2
# Abandon (puis nouvel essai) d'un téléchargement qui ne reçoit plus rien pendant ce délai
DOWNLOAD_STALL_MS=120000
# Limite mémoire du serveur si elle n'est pas détectée automatiquement (Mo)
# MEMORY_LIMIT_MB=1024
